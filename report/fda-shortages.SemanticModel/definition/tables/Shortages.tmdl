table Shortages
	lineageTag: 576934c1-d41c-4327-b2c8-f8d55435e7ee

	measure 'Active Shortages' = ```
			CALCULATE(DISTINCTCOUNT(Shortages[shortage_id]), Shortages[status] = "Current")
			
			```
		formatString: 0
		lineageTag: 46200b28-07f6-4a6d-80c7-764bc0b15820

	measure 'Drugs Affected' = ```
			CALCULATE(DISTINCTCOUNT(Shortages[generic_name]), Shortages[status] = "Current")
			
			```
		formatString: 0
		lineageTag: 653f64e1-9a78-41fc-bf60-9972cd370bc9

	measure 'Avg Days Open' = ```
			ROUND(AVERAGEX(CALCULATETABLE(VALUES(Shortages[shortage_id]), Shortages[status] = "Current"), CALCULATE(DATEDIFF(MIN(Shortages[initial_posting_date]), TODAY(), DAY))), 0)
			
			```
		lineageTag: a5ffe3d3-fb29-4585-ac38-6d92e0e15783

		annotation PBI_FormatHint = {"isGeneralNumber":true}

